# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed, or a fresh clone has no idea what to
# set. The wildcard above would otherwise swallow it silently.
!.env.example

# Prisma client is generated, never committed. The Docker builder stage runs
# `prisma generate` before `next build`; committing it guarantees a stale copy
# that disagrees with the schema at exactly the wrong moment.
/lib/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling
.vscode/
.idea/
