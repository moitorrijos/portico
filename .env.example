# Copy to `.env` for local development. `.env` itself is gitignored.
#
# Prisma 7 does NOT load .env automatically — prisma7.config.ts imports
# dotenv/config to do it. Next.js loads .env for the app itself.

# Local Postgres. Matches the production major version (18.x) on purpose:
# finding a version-specific difference locally is free, finding it on the
# box is not.
#
#   docker run -d --name portico-pg-dev \
#     -e POSTGRES_PASSWORD=devpassword -e POSTGRES_USER=portico \
#     -e POSTGRES_DB=portico_dev -p 127.0.0.1:5433:5432 postgres:18.4
#
# In production this is injected by `dokku postgres:link` — never set by hand.
DATABASE_URL="postgresql://portico:devpassword@127.0.0.1:5433/portico_dev?schema=public"

# Signs the session cookie. Generate with: openssl rand -base64 32
# Each environment has its own; sharing one would make a staging cookie valid
# in production.
SESSION_SECRET="dev-only-not-a-real-secret-aaaaaaaaaaaaaaaa="

# `production` is the ONLY value treated as production. Anything else is
# served noindex. See lib/indexing.ts.
APP_ENV="development"
APP_URL="http://localhost:3000"
